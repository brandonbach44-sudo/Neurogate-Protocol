# NeuroGate API Server — Environment Variables
# Copy to .env and fill in values before running.

# Port to listen on (default: 3001)
PORT=3001

# Allowed frontend origin for CORS
# Development: http://localhost:5173
# Production: https://neurogate.yourdomain.edu
CORS_ORIGIN=http://localhost:5173

# AWS S3 bucket for processed file storage (optional)
# If not set, files are written to /tmp and served via GET /api/download/:id
# S3_BUCKET=neurogate-data

# AWS region (default: us-east-1)
# AWS_REGION=us-east-1
