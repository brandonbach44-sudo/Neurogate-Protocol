{
  "name": "epilepsy-app",
  "private": true,
  "version": "0.0.0",
  "description": "NeuroGate: neural data organizer and BIDS export tool",
  "author": "NeuroGate",
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "regression": "tsx regression.ts && tsx regression_deidentify.ts",
    "regression:update": "tsx regression.ts --update && tsx regression_deidentify.ts --update",
    "verify:adapter": "tsx verify_adapter.ts",
    "verify:export": "tsx verify_export_writer.ts",
    "verify:cli": "tsx verify_cli_pipeline.ts",
    "cli": "tsx src/cli/index.ts",
    "cli:bundle": "node scripts/build-cli-bundle.mjs",
    "cli:sea": "npm run cli:bundle && node scripts/build-cli-sea.mjs",
    "verify:cli-bundle": "node scripts/verify-cli-bundle.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && npm run cli:sea && electron-builder"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "postject": "^1.0.0-alpha.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "build": {
    "appId": "org.upenn.neurogate",
    "productName": "NeuroGate",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!server/.env",
      "!server/.env.example",
      "!**/*.test.*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "dist-cli/neurogate.exe",
          "to": "cli/neurogate.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
