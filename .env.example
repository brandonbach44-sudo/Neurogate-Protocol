# NeuroGate — Frontend Environment Variables
# Copy to .env.local and fill in for local development.

# URL of the NeuroGate API server.
# When set, large EDF files (>500 MB) are uploaded to the server
# for streaming de-identification instead of failing in the browser.
#
# Development (server running locally):
#   VITE_API_URL=http://localhost:3001
#
# Production (EC2 behind ALB):
#   VITE_API_URL=https://api.neurogate.yourdomain.edu
#
# Leave unset to run fully client-side (Vercel / no backend).
# VITE_API_URL=http://localhost:3001
